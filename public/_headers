# Never cache the HTML entry point — always fetch fresh so asset hashes match
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Service worker must never be cached — browser needs to detect updates immediately
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Cache hashed assets forever — filenames change with every build so stale is impossible
/assets/*
  Cache-Control: public, max-age=31536000, immutable
